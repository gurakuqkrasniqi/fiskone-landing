rules_version = '2';

// The site can only ADD contact requests, never read, change or delete them. We read them
// in the Firebase console (or with an admin account). Every field is checked: names and
// sizes, so the collection cannot be used to store anything else.
service cloud.firestore {
  match /databases/{database}/documents {
    match /contactRequests/{id} {
      allow read, update, delete: if false;
      allow create: if isValidRequest(request.resource.data);
    }

    // Nothing else is open.
    match /{document=**} {
      allow read, write: if false;
    }

    function text(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isValidRequest(d) {
      return d.keys().hasOnly(['name', 'business', 'phone', 'email', 'businessType', 'tills', 'city', 'message', 'lang', 'page', 'consent', 'createdAt'])
        && d.keys().hasAll(['name', 'business', 'phone', 'consent', 'createdAt'])
        && text(d.name, 2, 100)
        && text(d.business, 2, 120)
        && text(d.phone, 6, 30)
        && (!('email' in d) || text(d.email, 0, 120))
        && (!('businessType' in d) || d.businessType in ['market', 'shop', 'cafe', 'restaurant', 'bakery', 'services', 'other'])
        && (!('tills' in d) || d.tills in ['1', '2-3', '4-10', '10+'])
        && (!('city' in d) || text(d.city, 0, 60))
        && (!('message' in d) || text(d.message, 0, 2000))
        && (!('lang' in d) || d.lang in ['sq', 'sr', 'en'])
        && (!('page' in d) || text(d.page, 0, 100))
        && d.consent == true
        && d.createdAt == request.time;
    }
  }
}
